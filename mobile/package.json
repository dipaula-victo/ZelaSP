  "description": "ZelaSP: zeladoria no Jabaquara e Risco Cidadão",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "test:web": "node tests/web-smoke.mjs",
    "format": "prettier --write app src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
