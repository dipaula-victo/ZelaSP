    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
